DISCORD_TOKEN=replace_with_your_bot_token
GUILD_ID=replace_with_server_id
SUBMISSIONS_CHANNEL_ID=replace_with_submissions_channel_id
LEADERBOARD_CHANNEL_ID=replace_with_leaderboard_channel_id

DATABASE_PATH=data/leaderboard.sqlite3

# Optional: require this role for admin commands.
# Leave 0 to require Manage Server permission instead.
ADMIN_ROLE_ID=0

# Optional: existing audit channel for admin changes and failure reports.
# Leave 0 to disable channel logging.
AUDIT_CHANNEL_ID=0

# Retry failed/unprocessed images within this window on startup.
# Default 72 hours; 0 disables scanning.
HISTORY_LOOKBACK_HOURS=72

# Windows only, if Tesseract is not on PATH:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
