DISCORD_TOKEN=replace_with_your_bot_token
GUILD_ID=replace_with_server_id
SUBMISSIONS_CHANNEL_ID=replace_with_submissions_channel_id
LEADERBOARD_CHANNEL_ID=replace_with_leaderboard_channel_id

DATABASE_PATH=data/leaderboard.sqlite3

# Optional: require this role for admin commands.
# Leave 0 to require Manage Server permission instead.
ADMIN_ROLE_ID=0

# Optional: existing audit channel for admin changes and failure reports.
# Leave 0 to disable channel logging.
AUDIT_CHANNEL_ID=0

# Retry failed/unprocessed images within this window on startup.
# Default 72 hours; 0 disables scanning.
HISTORY_LOOKBACK_HOURS=72

# Windows only, if Tesseract is not on PATH:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Durable queue and image storage (relative paths resolve from the bot folder).
# Leave paths commented to keep them beside DATABASE_PATH automatically.
# SPOOL_PATH=data/spool
# BACKUP_PATH=data/backups
QUEUE_MAX_PENDING=2000
QUEUE_MAX_PER_USER=5
SPOOL_MAX_MB=2048
SPOOL_MIN_FREE_MB=512
DOWNLOAD_WORKERS=2
DOWNLOAD_TIMEOUT_SECONDS=90
OCR_JOB_TIMEOUT_SECONDS=180
JOB_MAX_ATTEMPTS=3
JOB_RETRY_SECONDS=60
FAILED_IMAGE_RETENTION_HOURS=72
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7
LEADERBOARD_REFRESH_SECONDS=30
# Queued OCR always enforces one Tesseract/OpenCV/BLAS thread in its subprocess.
