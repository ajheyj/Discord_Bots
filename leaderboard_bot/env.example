DISCORD_TOKEN=replace_with_your_bot_token
GUILD_ID=replace_with_server_id
SUBMISSIONS_CHANNEL_ID=replace_with_leaderboard_submissions_channel_id
LEADERBOARD_CHANNEL_ID=replace_with_leaderboard_channel_id
DATABASE_PATH=data/leaderboard.sqlite3
# Windows only if tesseract is not on PATH (remove the #):
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Optional: exact role required for admin commands (no administrator bypass).
# Unset/0 preserves the earlier Manage Server requirement.
ADMIN_ROLE_ID=0
# Optional: private text channel for admin correction/removal logs.
AUDIT_CHANNEL_ID=0
